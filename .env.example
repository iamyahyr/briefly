# ─── Core ──────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgres://briefly:briefly@localhost:5432/briefly
# Public URL where Briefly is reachable (used for links and auth callbacks)
APP_URL=http://localhost:3000
# Random secret, at least 32 chars. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Set to true to block new sign-ups once your account exists
DISABLE_SIGNUP=false
# Migrations run automatically when the server starts; set to false to run them yourself
# RUN_MIGRATIONS_ON_START=true
# Password for the database bundled in docker-compose.yml
# POSTGRES_PASSWORD=briefly

# ─── File storage ──────────────────────────────────────────────────────
# "local" stores files on disk, "s3" uses any S3-compatible service
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/uploads
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=auto
# S3_BUCKET=briefly
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Upload limits (megabytes)
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_BRIEF_MB=100

# ─── Email (optional) ──────────────────────────────────────────────────
# Without SMTP, password-reset links are printed to the server log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Briefly <no-reply@example.com>"

# ─── OAuth (optional) ──────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
